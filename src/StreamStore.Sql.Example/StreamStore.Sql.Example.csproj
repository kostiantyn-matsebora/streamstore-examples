<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\submodules\streamstore\src\StreamStore.Sql.PostgreSql\StreamStore.Sql.PostgreSql.csproj" />
    <ProjectReference Include="..\..\submodules\streamstore\src\StreamStore.Sql.Sqlite\StreamStore.Sql.Sqlite.csproj" />
    <ProjectReference Include="..\..\submodules\streamstore\src\StreamStore.Sql\StreamStore.Sql.csproj" />
    <ProjectReference Include="..\StreamStore.ExampleBase\StreamStore.ExampleBase.csproj" />
  </ItemGroup>

</Project>
